# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Gemini AI API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (used for CRAT analysis and the AI grant report download)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth client id (Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth 2.0 Client ID, type "Web application"). Used for
# "Sign up with Google" on the auth pages.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# API Base URL
VITE_API_BASE_URL=http://localhost:3000

# Other environment variables
VITE_NODE_ENV=development
